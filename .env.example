PORT=3000
HOTEL_NAME=Hotel Canal
NODE_ENV=production
REPORT_EMAIL=
# Mai info@hotelcanal.com — inbox hotel, non report di sistema
# URL pubblico HTTPS (dominio custom / Render). Serve a email, QR, WhatsApp media.
PUBLIC_URL=https://checkin-hotelcanal.it

# Segreti production (≥24 caratteri random ciascuno)
CRON_SECRET=
GUEST_ACCESS_SECRET=
COUPON_SECRET=
# AES-256-GCM per telefono/email/nome at rest (≥32 char)
FIELD_ENCRYPTION_KEY=
# Trigger report da form (nome=cognome=telefono=questo token). Vuoto = disabilitato.
REPORT_TRIGGER_TOKEN=

CRON_TZ=Europe/Rome
# Disco persistente Render:
DATABASE_PATH=/var/data/checkins.db
# Locale senza disco:
# DATABASE_PATH=./data/checkins.db

# Backup Gist (consigliato anche con disco)
# CHECKIN_BACKUP_GIST_ID=
# CHECKIN_BACKUP_GITHUB_TOKEN=

# Email ospiti — Resend + dominio verificato (checkin-hotelcanal.it)
RESEND_API_KEY=
SMTP_FROM="Welcome to Hotel Canal <checkin@checkin-hotelcanal.it>"
# Opzionale mittente report (default: SMTP_FROM con display name Front Desk)
# REPORT_FROM="Hotel Canal Front Desk <checkin@checkin-hotelcanal.it>"

# Wi-Fi / porte — in locale e su Render.
WIFI_SSID=hotel canal
WIFI_PASSWORD=
WIFI_SSID_AIRONE=hotel airone
WIFI_SSID_APARTMENT=Ca Pisani Vista Canal
WIFI_PASSWORD_APARTMENT=
WIFI_TYPE=WPA
DOOR_CODE_WALTER=
DOOR_CODE_AIRONE=

# Dashboard staff (/staff) — hash scrypt. All'avvio gli hash STAFF_PIN_*
# vengono copiati nel database; il login legge solo pin_hash, mai il chiaro.
#   node scripts/hash-staff-pin.mjs "pin-segreto"
#   node scripts/hash-staff-pin.mjs --roster
STAFF_PIN_TOMMASO=
STAFF_PIN_JOHN=
STAFF_PIN_ALEJANDRO=
STAFF_PIN_MARIA=
STAFF_PIN_MIZAN=
STAFF_PIN_PAYEL=
STAFF_PIN_SAYEED=

# Account tester (solo email/telefono esatti). Vuoto = nessuno e' tester.
# Un ospite omonimo NON diventa tester.
# TESTER_EMAILS=dev@example.com
# TESTER_PHONES=+393331112233

# WhatsApp Payel (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_PAYEL=
# TABLE_BOOKING_EMAIL=

# TRATTORIA_PHONE=+393282464972
# TRATTORIA_PHONE_DISPLAY=328 246 4972
# TRATTORIA_TRIPADVISOR_URL=https://www.tripadvisor.it/Restaurant_Review-g187870-d34095681-Reviews-Trattoria_Alla_Terrazza-Venice_Veneto.html
# TRATTORIA_TRIPADVISOR_RATING=4.3
