PORT=3000
HOTEL_NAME=Hotel Canal
# Opzionale: ragione sociale in footer login staff (es. CANAL S.r.l.)
HOTEL_LEGAL_NAME=
NODE_ENV=production

# Destinatario report (test / canale ops). Inbox ufficiale solo cron produzione.
REPORT_EMAIL=
REPORT_EMAIL_OFFICIAL=
# REPORT_EMAIL_TEST=

# Orario report notturno (Europe/Rome). Se impostato in env, blocca la modifica da Impostazioni staff.
# Altrimenti l’orario si cambia da /staff → Impostazioni (default app: 22:35).
# REPORT_SEND_TIME=22:35

PUBLIC_URL=https://checkin-hotelcanal.it

# Lab segreto Riva OS (/lab) — docs/LAB-SEGRETO.md
# RIVA_LAB_SECRET=
# RIVA_LAB_GUARD=1

# IBAN hotel — link /paga. Oppure da Impostazioni staff.
# HOTEL_IBAN=IT60X0542811101000000123456
# HOTEL_IBAN_HOLDER=Hotel Canal
# HOTEL_IBAN_BANK=

# Segreti production (≥24 caratteri random ciascuno, tutti diversi)
CRON_SECRET=
GUEST_ACCESS_SECRET=
COUPON_SECRET=
# AES-256-GCM telefono/email/nome at rest (≥32 char)
FIELD_ENCRYPTION_KEY=
# Trigger report da form (nome=cognome=telefono=questo token). Vuoto = off.
REPORT_TRIGGER_TOKEN=

CRON_TZ=Europe/Rome
HOTEL_CHECKOUT_TIME=10:30
HOTEL_CHECKOUT_GRACE_HOURS=3

# Disco persistente Render:
DATABASE_PATH=/var/data/checkins.db
# Locale:
# DATABASE_PATH=./data/checkins.db
# Allegati prenotazioni (default: cartella hold-docs accanto al DB)
# HOLD_DOCS_DIR=/var/data/hold-docs

# Backup Gist (consigliato anche con disco)
# CHECKIN_BACKUP_GIST_ID=
# CHECKIN_BACKUP_GITHUB_TOKEN=

# Email ospiti — Resend + dominio verificato
RESEND_API_KEY=
SMTP_FROM="Welcome to Hotel Canal <checkin@checkin-hotelcanal.it>"
# REPORT_FROM="Hotel Canal Front Desk <checkin@checkin-hotelcanal.it>"

# Wi-Fi / porte (valori reali solo su Render / .env locale, mai in git)
WIFI_SSID=
WIFI_PASSWORD=
WIFI_SSID_AIRONE=
WIFI_PASSWORD_AIRONE=
WIFI_SSID_APARTMENT=
WIFI_PASSWORD_APARTMENT=
WIFI_TYPE=WPA
DOOR_CODE_WALTER=
DOOR_CODE_AIRONE=

# Dashboard staff (/staff) — hash scrypt (mai PIN in chiaro su Render)
#   node scripts/hash-staff-pin.mjs "pin-segreto"
#   node scripts/hash-staff-pin.mjs --roster
STAFF_PIN_TOMMASO=
STAFF_PIN_JOHN=
STAFF_PIN_ALEJANDRO=
STAFF_PIN_MARIA=
STAFF_PIN_MIZAN=
STAFF_PIN_PAYEL=
STAFF_PIN_SAYEED=
# Inventario camere fisiche (HK / tabellone). Es: 105,114,202,203
# Se vuoto: lista default Hotel Canal.
HOTEL_ROOMS=

# Tester (email/telefono esatti). Vuoto = nessuno.
# TESTER_EMAILS=dev@example.com
# TESTER_PHONES=+393331112233

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_PAYEL=
# TABLE_BOOKING_EMAIL=

# Monitoring ops (opzionale) — POST JSON su fallimento report / blockers /api/ready
# MONITOR_WEBHOOK_URL=https://hooks.slack.com/services/...
