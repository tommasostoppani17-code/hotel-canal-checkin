PORT=3000
HOTEL_NAME=Hotel Canal
REPORT_EMAIL=tommasostoppani17@gmail.com
# URL pubblico HTTPS dell'app (Render). Serve alle foto email remote (anti-troncamento Gmail).
# Non usare localhost: le mail non vedrebbero le immagini.
PUBLIC_URL=https://tuo-servizio.onrender.com
CRON_SECRET=change-me-to-a-long-random-string
CRON_TZ=Europe/Rome
DATABASE_PATH=./data/checkins.db
# Con disco Render: /var/data/checkins.db
# Backup durable (Gist) se resti sul piano free:
# CHECKIN_BACKUP_GIST_ID=
# CHECKIN_BACKUP_GITHUB_TOKEN=

# Email — come Emily: preferisci Resend
RESEND_API_KEY=
# Produzione: dominio verificato su Resend, es.
# SMTP_FROM="Welcome to Hotel Canal <checkin@hotelcanal.com>"
# Fino a dominio verificato, Resend accetta solo onboarding@resend.dev → mail solo al tuo account
SMTP_FROM="Welcome to Hotel Canal <onboarding@resend.dev>"

# Oppure SMTP classico (fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Wi-Fi QR reception (non committare password reale nel repo)
WIFI_SSID=hotel canal
WIFI_PASSWORD=
WIFI_TYPE=WPA

# Codici porta accessi (welcome email)
DOOR_CODE_WALTER="5358#"
DOOR_CODE_AIRONE=532E

# WhatsApp report notturno → Payel (Twilio). Email REPORT_EMAIL resta per archivio Canal.
# Sandbox Twilio: numero mittente tipico whatsapp:+14155238886
# Destinatario deve aver attivato la sandbox (messaggio join al numero Twilio).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_PAYEL=+393514362677
# Stessi TWILIO_* servono anche per l'alert immediato "Prenota un tavolo"
# (WhatsApp a Payel). Senza Twilio parte comunque l'email TABLE_BOOKING_EMAIL / REPORT_EMAIL.

# Alert immediato prenotazione tavolo (default = REPORT_EMAIL). Gratis via Resend.
# TABLE_BOOKING_EMAIL=tommasostoppani17@gmail.com

# Telefono Trattoria (tap-to-call sullo Step 3)
# TRATTORIA_PHONE=+393282464972
# TRATTORIA_PHONE_DISPLAY=328 246 4972
